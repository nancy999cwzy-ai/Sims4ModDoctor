<Window x:Class="Sims4ModDoctor.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sims 4 Mod Doctor - 模拟人生4 Mod 医生" 
        Height="720" Width="1180"
        MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="#F5F7FA">

    <Window.Resources>
        <!-- 侧边栏按钮样式 -->
        <Style x:Key="NavButtonStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#CDCDDE"/>
            <Setter Property="Height" Value="45"/>
            <Setter Property="Margin" Value="0,4"/>
            <Setter Property="Padding" Value="15,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Left"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#2B2B40"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#0095E8"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 1. 左侧侧边栏 -->
        <Border Grid.Column="0" Background="#1E1E2D">
            <DockPanel>
                <!-- Logo 区 -->
                <StackPanel DockPanel.Dock="Top" Margin="20,25,20,30" Orientation="Horizontal">
                    <Border Width="36" Height="36" Background="#0095E8" CornerRadius="8" Margin="0,0,12,0">
                        <TextBlock Text="MD" Foreground="White" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Mod Doctor" Foreground="White" FontSize="18" FontWeight="Bold"/>
                        <TextBlock Text="Sims 4 Diagnostics" Foreground="#A1A5B7" FontSize="11" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- 底部版本 -->
                <TextBlock DockPanel.Dock="Bottom" Text="v1.0.0 | .NET 8 WPF" 
                           Foreground="#474761" FontSize="11" Margin="20" HorizontalAlignment="Center"/>

                <!-- 导航菜单 -->
                <StackPanel Margin="12,0">
                    <RadioButton Content="首页大盘" IsChecked="True" Style="{StaticResource NavButtonStyle}"/>
                    <RadioButton Content="Mod 列表与图库" Style="{StaticResource NavButtonStyle}"/>
                    <RadioButton Content="冲突/失效诊断" Style="{StaticResource NavButtonStyle}"/>
                    <RadioButton Content="安全隔离区" Style="{StaticResource NavButtonStyle}"/>
                    <RadioButton Content="系统与规则设置" Style="{StaticResource NavButtonStyle}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 2. 右侧主内容区 -->
        <Grid Grid.Column="1" Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 顶部工具栏 -->
            <Border Grid.Row="0" Background="White" CornerRadius="8" Padding="20,12" Margin="0,0,0,15">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="当前 Mods 目录: " FontWeight="Bold" Foreground="#3F4254" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtModsPath" Text="未选择目录 (请点击右侧按钮选择)" Foreground="#B5B5C3" VerticalAlignment="Center" Margin="5,0,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="选择文件夹" Click="BtnSelectFolder_Click" Width="100" Height="34" Margin="0,0,10,0" Background="#E1F0FF" Foreground="#0095E8" FontWeight="SemiBold" BorderThickness="0"/>
                        <Button Content="开始全面扫描" Click="BtnStartScan_Click" Width="120" Height="34" Background="#0095E8" Foreground="White" FontWeight="Bold" BorderThickness="0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 主内容视图 -->
            <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="25">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Border Width="80" Height="80" Background="#E1F0FF" CornerRadius="40" Margin="0,0,0,20">
                        <TextBlock Text="🩺" FontSize="36" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="欢迎使用 Sims 4 Mod Doctor" FontSize="22" FontWeight="Bold" Foreground="#181C32" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="TxtStatus" Text="界面框架就绪。请点击右上角选择你的 Sims 4 Mods 文件夹进行扫描。" Foreground="#7E8299" FontSize="14" Margin="0,10,0,0" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>