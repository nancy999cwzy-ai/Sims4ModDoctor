<Window x:Class="Sims4ModDoctor.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Sims4ModDoctor.UI"
        Title="Sims 4 Mod Doctor - 智能医生助手" Height="760" Width="1200"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <local:ThumbnailBytesConverter x:Key="ThumbnailConverter"/>
        <local:CardThumbnailConverter x:Key="CardThumbnailConverter"/>
        <local:CategoryBadgeBrushConverter x:Key="BadgeBrushConverter"/>
        <local:CategoryShortBadgeConverter x:Key="ShortBadgeConverter"/>

        <!-- Mod 大图卡片模板（列表 / 隔离区共用） -->
        <DataTemplate x:Key="ModCardTemplate">
            <Border Width="210" Margin="8" Background="#FFFFFF" CornerRadius="12"
                    BorderBrush="#E4E6EF" BorderThickness="1" Cursor="Hand"
                    SnapsToDevicePixels="True">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.08" Color="#000000"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="200"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 缩略图 / 分类占位 -->
                    <Grid Grid.Row="0" ClipToBounds="True">
                        <Border CornerRadius="12,12,0,0"
                                Background="{Binding Category, Converter={StaticResource BadgeBrushConverter}}"
                                Opacity="0.88"/>
                        <TextBlock Text="{Binding Category, Converter={StaticResource ShortBadgeConverter}}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   FontSize="20" FontWeight="Bold" Foreground="#FFFFFF" Opacity="0.95"/>
                        <Image Stretch="UniformToFill"
                               Source="{Binding Converter={StaticResource CardThumbnailConverter}}">
                            <Image.Style>
                                <Style TargetType="Image">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasThumbnail}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Image.Style>
                        </Image>
                    </Grid>

                    <!-- 名称 -->
                    <TextBlock Grid.Row="1" Margin="12,10,12,4"
                               Text="{Binding Name}" FontWeight="SemiBold" FontSize="13"
                               Foreground="#181C32" TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding Name}"/>

                    <!-- 分类 Badge + 大小 -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="12,0,12,12">
                        <Border CornerRadius="4" Padding="8,3"
                                Background="{Binding Category, Converter={StaticResource BadgeBrushConverter}}">
                            <TextBlock Text="{Binding Category, Converter={StaticResource ShortBadgeConverter}}"
                                       Foreground="#FFFFFF" FontSize="11" FontWeight="SemiBold"/>
                        </Border>
                        <TextBlock Text="{Binding SizeDisplay}" Margin="8,0,0,0"
                                   VerticalAlignment="Center" Foreground="#A1A5B7" FontSize="11"/>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid Background="#F5F6F8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 左侧侧边栏 Navigation -->
        <Border Grid.Column="0" Background="#1E1E2D" Padding="15">
            <StackPanel>
                <TextBlock Text="MD" Foreground="#3699FF" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,10,0,5"/>
                <TextBlock Text="Sims 4 Mod Doctor" Foreground="#FFFFFF" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,30"/>

                <Button Content="[+] 首页大盘" Click="BtnDashboard_Click" Style="{StaticResource NavButtonStyle}" Margin="0,0,0,10"/>
                <Button Content="[-] Mod 列表与简易整理" Click="BtnModList_Click" Style="{StaticResource NavButtonStyle}" Margin="0,0,0,10"/>
                <Button Content="[!] 冲突/失效诊断" Click="BtnDiagnosis_Click" Style="{StaticResource NavButtonStyle}" Margin="0,0,0,10"/>
                <Button Content="[*] 安全隔离区" Click="BtnQuarantine_Click" Style="{StaticResource NavButtonStyle}" Margin="0,0,0,10"/>
                <Button Content="[#] 系统与规则设置" Style="{StaticResource NavButtonStyle}" Margin="0,0,0,10"/>
            </StackPanel>
        </Border>

        <!-- 右侧主内容区 -->
        <Grid Grid.Column="1" Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 顶部文件夹选择 -->
            <Border Grid.Row="0" Background="#FFFFFF" CornerRadius="8" Padding="15" Margin="0,0,0,15">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="TxtModsPath" Grid.Column="0" Text="请选择或粘贴你的 Sims 4 Mods 文件夹路径..." VerticalAlignment="Center" Padding="8,6" Foreground="#888888" Margin="0,0,10,0"/>
                    <Button x:Name="BtnSelectFolder" Content="选择文件夹" Grid.Column="1" Click="BtnSelectFolder_Click" Width="100" Height="32" Margin="0,0,10,0"/>
                    <Button x:Name="BtnStartScan" Content="开始全面扫描" Grid.Column="2" Click="BtnStartScan_Click" Width="110" Height="32" Background="#3699FF" Foreground="#FFFFFF"/>
                </Grid>
            </Border>

            <!-- 搜索与快捷工具条 -->
            <Grid x:Name="PanelListToolbar" Grid.Row="1" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="TxtSearch" Grid.Column="0" TextChanged="TxtSearch_TextChanged" Padding="10,8" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnOrganize" Content="⚡ 一键智能整理" Click="BtnOrganize_Click" Visibility="Collapsed"
                            Height="32" Padding="12,0" Background="#FFF4DE" Foreground="#FFA800" FontWeight="Bold" Cursor="Hand"/>
                    <Button x:Name="BtnFixScripts" Content="⚡ 一键平铺修复失效脚本" Click="BtnFixScripts_Click" Visibility="Collapsed"
                            Height="32" Padding="12,0" Margin="8,0,0,0" Background="#E1F0FF" Foreground="#3699FF" FontWeight="Bold" Cursor="Hand"/>
                    <Button x:Name="BtnRestoreQuarantine" Content="↩ 一键还原隔离区" Click="BtnRestoreQuarantine_Click" Visibility="Collapsed"
                            Height="32" Padding="12,0" Margin="8,0,0,0" Background="#E8FFF3" Foreground="#0F9D58" FontWeight="Bold" Cursor="Hand"/>
                    <Button x:Name="BtnClearQuarantine" Content="✖ 彻底清空隔离区" Click="BtnClearQuarantine_Click" Visibility="Collapsed"
                            Height="32" Padding="12,0" Margin="8,0,0,0" Background="#FFF5F8" Foreground="#F1416C" FontWeight="Bold" Cursor="Hand"/>
                </StackPanel>
            </Grid>

            <!-- 诊断提示栏 -->
            <Border x:Name="PanelDiagnosis" Grid.Row="2" Visibility="Collapsed"
                    Background="#FFF8E7" BorderBrush="#FFA800" BorderThickness="1"
                    CornerRadius="8" Padding="18,14" Margin="0,0,0,15">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,15,0">
                        <TextBlock x:Name="TxtDiagRound" Text="诊断模式" Foreground="#B87500" FontSize="17" FontWeight="Bold" Margin="0,0,0,7"/>
                        <TextBlock x:Name="TxtDiagCounts" Text="保留测试组：0 个文件  |  暂时隔离组：0 个文件" Foreground="#3F4254" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,5" TextWrapping="Wrap"/>
                        <TextBlock x:Name="TxtDiagGuide" Text="请启动游戏测试问题是否存在，回到本界面后点击右侧按钮反馈结果。" Foreground="#7E8299" FontSize="12" TextWrapping="Wrap"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="BtnProblemYes" Content="问题依然存在" Click="BtnProblemYes_Click"
                                Width="115" Height="34" Margin="0,0,8,0" Background="#F1416C" Foreground="#FFFFFF" FontWeight="Bold" Cursor="Hand"/>
                        <Button x:Name="BtnProblemNo" Content="问题消失了" Click="BtnProblemNo_Click"
                                Width="105" Height="34" Margin="0,0,8,0" Background="#50CD89" Foreground="#FFFFFF" FontWeight="Bold" Cursor="Hand"/>
                        <Button x:Name="BtnExitDiagnosis" Content="退出诊断" Click="BtnExitDiagnosis_Click"
                                Width="85" Height="34" Background="#EFF2F5" Foreground="#5E6278" Cursor="Hand"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 主内容：大盘 / Mod 浏览器 / 隔离区 -->
            <Grid Grid.Row="3">
                <!-- 首页大盘 -->
                <ScrollViewer x:Name="PanelDashboard" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="首页大盘" FontSize="20" FontWeight="Bold" Foreground="#181C32" Margin="0,0,0,6"/>
                        <TextBlock x:Name="TxtDashboardHint" Text="请先选择 Mods 目录并完成全面扫描，即可查看可视化统计。"
                                   Foreground="#A1A5B7" FontSize="13" Margin="0,0,0,16"/>
                        <UniformGrid Columns="4" Margin="0,0,0,18">
                            <Border Background="#FFFFFF" CornerRadius="10" Padding="16" Margin="0,0,10,0" BorderBrush="#EFF2F5" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="Mod 总数" Foreground="#A1A5B7" FontSize="12"/>
                                    <TextBlock x:Name="TxtDashTotalMods" Text="0" FontSize="28" FontWeight="Bold" Foreground="#181C32" Margin="0,8,0,0"/>
                                    <TextBlock Text="已扫描文件" Foreground="#B5B5C3" FontSize="11" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Background="#FFFFFF" CornerRadius="10" Padding="16" Margin="0,0,10,0" BorderBrush="#EFF2F5" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="总占用体积" Foreground="#A1A5B7" FontSize="12"/>
                                    <TextBlock x:Name="TxtDashTotalSize" Text="0 MB" FontSize="28" FontWeight="Bold" Foreground="#3699FF" Margin="0,8,0,0"/>
                                    <TextBlock Text="磁盘占用估算" Foreground="#B5B5C3" FontSize="11" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Background="#FFFFFF" CornerRadius="10" Padding="16" Margin="0,0,10,0" BorderBrush="#EFF2F5" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="脚本 Mod" Foreground="#A1A5B7" FontSize="12"/>
                                    <TextBlock x:Name="TxtDashScriptCount" Text="0" FontSize="28" FontWeight="Bold" Foreground="#50CD89" Margin="0,8,0,0"/>
                                    <TextBlock Text=".ts4script 文件" Foreground="#B5B5C3" FontSize="11" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Background="#FFFFFF" CornerRadius="10" Padding="16" BorderBrush="#EFF2F5" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="潜在异常" Foreground="#A1A5B7" FontSize="12"/>
                                    <TextBlock x:Name="TxtDashAnomalyCount" Text="0" FontSize="28" FontWeight="Bold" Foreground="#F1416C" Margin="0,8,0,0"/>
                                    <TextBlock Text="脚本嵌套过深等" Foreground="#B5B5C3" FontSize="11" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                        <Border Background="#FFFFFF" CornerRadius="10" Padding="20" BorderBrush="#EFF2F5" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="DBPF 功能部位占比" FontSize="16" FontWeight="SemiBold" Foreground="#181C32" Margin="0,0,0,14"/>
                                <ItemsControl x:Name="CategoryStatsList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="130"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="150"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Label}" VerticalAlignment="Center" Foreground="#3F4254" FontWeight="SemiBold" FontSize="12"/>
                                                <ProgressBar Grid.Column="1" Height="12" Minimum="0" Maximum="100"
                                                             Value="{Binding Percent}" Background="#F1F3F8" Margin="0,0,12,0"
                                                             Foreground="{Binding BarBrush}"/>
                                                <TextBlock Grid.Column="2" Text="{Binding StatsText}" VerticalAlignment="Center" Foreground="#7E8299" FontSize="12"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- Mod 列表：左侧文件夹树 + 右侧卡片网格 -->
                <Grid x:Name="PanelModBrowser">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="230"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="#FFFFFF" CornerRadius="10" Margin="0,0,12,0"
                            BorderBrush="#EFF2F5" BorderThickness="1" Padding="10">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="文件夹" FontWeight="SemiBold"
                                       Foreground="#181C32" Margin="4,2,4,10"/>
                            <TreeView x:Name="TreeFolders" BorderThickness="0" Background="Transparent"
                                      SelectedItemChanged="TreeFolders_SelectedItemChanged"/>
                        </DockPanel>
                    </Border>

                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- 分类筛选 + 卡片缩放 -->
                        <Border Grid.Row="0" Background="#FFFFFF" CornerRadius="8" Padding="12,8" Margin="0,0,0,10"
                                BorderBrush="#EFF2F5" BorderThickness="1">
                            <DockPanel LastChildFill="False">
                                <TextBlock Text="分类" VerticalAlignment="Center" Foreground="#7E8299" Margin="0,0,8,0"/>
                                <ComboBox x:Name="CmbCategoryFilter" Width="150" Height="30" VerticalAlignment="Center"
                                          SelectionChanged="CmbCategoryFilter_SelectionChanged"/>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="卡片缩放" VerticalAlignment="Center" Foreground="#7E8299" Margin="0,0,10,0"/>
                                    <Slider x:Name="SliderCardZoom" Width="140" Minimum="0.7" Maximum="1.45" Value="1.0"
                                            TickFrequency="0.05" IsSnapToTickEnabled="False"
                                            VerticalAlignment="Center" ValueChanged="SliderCardZoom_ValueChanged"/>
                                    <TextBlock x:Name="TxtZoomPercent" Text="100%" Width="42" Margin="8,0,0,0"
                                               VerticalAlignment="Center" Foreground="#A1A5B7" FontSize="12"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                      Background="Transparent" Padding="0,0,4,0">
                            <ItemsControl x:Name="ModCardGrid" ItemTemplate="{StaticResource ModCardTemplate}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.LayoutTransform>
                                    <ScaleTransform x:Name="CardScaleTransform" ScaleX="1" ScaleY="1"/>
                                </ItemsControl.LayoutTransform>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Grid>

                <!-- 隔离区：同款卡片网格（无文件夹树） -->
                <ScrollViewer x:Name="PanelQuarantineBrowser" Visibility="Collapsed"
                              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="QuarantineCardGrid" ItemTemplate="{StaticResource ModCardTemplate}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

            <Border Grid.Row="4" Background="#FFFFFF" Padding="10" Margin="0,15,0,0" CornerRadius="4">
                <TextBlock x:Name="TxtStatus" Text="系统准备就绪，请选择 Mods 目录进行扫描。" Foreground="#5E6278"/>
            </Border>
        </Grid>
    </Grid>
</Window>
