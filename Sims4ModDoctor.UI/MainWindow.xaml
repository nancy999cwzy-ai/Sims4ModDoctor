<Window x:Class="Sims4ModDoctor.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sims 4 Mod Doctor - 智能医生助手" Height="680" Width="1050"
        WindowStartupLocation="CenterScreen">
    
    <Grid Background="#F5F6F8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 左侧侧边栏 Navigation -->
        <Border Grid.Column="0" Background="#1E1E2D" Padding="15">
            <StackPanel>
                <TextBlock Text="MD" Foreground="#3699FF" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,10,0,5"/>
                <TextBlock Text="Sims 4 Mod Doctor" Foreground="#FFFFFF" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,30"/>

                <Button Content="[+] 首页大盘" Style="{StaticResource NavButtonStyle}" Margin="0,0,0,10"/>
                <Button Content="[-] Mod 列表与简易整理" Style="{StaticResource NavButtonStyle}" Margin="0,0,0,10"/>
                <Button Content="[!] 冲突/失效诊断" Click="BtnDiagnosis_Click" Style="{StaticResource NavButtonStyle}" Margin="0,0,0,10"/>
                <Button Content="[*] 安全隔离区" Style="{StaticResource NavButtonStyle}" Margin="0,0,0,10"/>
                <Button Content="[#] 系统与规则设置" Style="{StaticResource NavButtonStyle}" Margin="0,0,0,10"/>
            </StackPanel>
        </Border>

        <!-- 右侧主内容区 Panel -->
        <Grid Grid.Column="1" Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 顶部文件夹选择 -->
            <Border Grid.Row="0" Background="#FFFFFF" CornerRadius="8" Padding="15" Margin="0,0,0,15">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <TextBox x:Name="TxtModsPath" Grid.Column="0" Text="请选择或粘贴你的 Sims 4 Mods 文件夹路径..." VerticalAlignment="Center" Padding="8,6" Foreground="#888888" Margin="0,0,10,0"/>
                    <Button x:Name="BtnSelectFolder" Content="选择文件夹" Grid.Column="1" Click="BtnSelectFolder_Click" Width="100" Height="32" Margin="0,0,10,0"/>
                    <Button x:Name="BtnStartScan" Content="开始全面扫描" Grid.Column="2" Click="BtnStartScan_Click" Width="110" Height="32" Background="#3699FF" Foreground="#FFFFFF"/>
                </Grid>
            </Border>

            <!-- 搜索框与快捷修复工具条 -->
            <Grid Grid.Row="1" Margin="0,0,0,15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <TextBox x:Name="TxtSearch" Grid.Column="0" TextChanged="TxtSearch_TextChanged" Padding="10,8" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <Button x:Name="BtnFixScripts" Grid.Column="1" Content="⚡ 一键平铺修复失效脚本" Click="BtnFixScripts_Click" Visibility="Collapsed" Height="32" Padding="12,0" Background="#E1F0FF" Foreground="#3699FF" FontWeight="Bold"/>
            </Grid>

            <!-- 诊断模式提示栏：仅在二分排查进行中显示 -->
            <Border x:Name="PanelDiagnosis" Grid.Row="2" Visibility="Collapsed"
                    Background="#FFF8E7" BorderBrush="#FFA800" BorderThickness="1"
                    CornerRadius="8" Padding="18,14" Margin="0,0,0,15">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,15,0">
                        <TextBlock x:Name="TxtDiagRound" Text="诊断模式" Foreground="#B87500" FontSize="17" FontWeight="Bold" Margin="0,0,0,7"/>
                        <TextBlock x:Name="TxtDiagCounts" Text="保留测试组：0 个文件  |  暂时隔离组：0 个文件" Foreground="#3F4254" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,5" TextWrapping="Wrap"/>
                        <TextBlock x:Name="TxtDiagGuide" Text="请启动游戏测试问题是否存在，回到本界面后点击右侧按钮反馈结果。" Foreground="#7E8299" FontSize="12" TextWrapping="Wrap"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="BtnProblemYes" Content="问题依然存在" Click="BtnProblemYes_Click"
                                Width="115" Height="34" Margin="0,0,8,0" Background="#F1416C" Foreground="#FFFFFF" FontWeight="Bold" Cursor="Hand"/>
                        <Button x:Name="BtnProblemNo" Content="问题消失了" Click="BtnProblemNo_Click"
                                Width="105" Height="34" Margin="0,0,8,0" Background="#50CD89" Foreground="#FFFFFF" FontWeight="Bold" Cursor="Hand"/>
                        <Button x:Name="BtnExitDiagnosis" Content="退出诊断" Click="BtnExitDiagnosis_Click"
                                Width="85" Height="34" Background="#EFF2F5" Foreground="#5E6278" Cursor="Hand"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 数据展示表格 DataGrid -->
            <DataGrid x:Name="GridModList" Grid.Row="3" AutoGenerateColumns="False" IsReadOnly="True" GridLinesVisibility="Horizontal" HeadersVisibility="Column" Background="#FFFFFF">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Mod 文件名" Binding="{Binding Name}" Width="2*"/>
                    <DataGridTextColumn Header="智能分类" Binding="{Binding CategoryDisplay}" Width="1.2*"/>
                    <DataGridTextColumn Header="文件类型" Binding="{Binding TypeDisplay}" Width="1.2*"/>
                    <DataGridTextColumn Header="大小" Binding="{Binding SizeDisplay}" Width="*"/>
                    <DataGridTextColumn Header="相对路径" Binding="{Binding RelativePath}" Width="3*"/>
                </DataGrid.Columns>
            </DataGrid>

            <!-- 底部状态栏 -->
            <Border Grid.Row="4" Background="#FFFFFF" Padding="10" Margin="0,15,0,0" CornerRadius="4">
                <TextBlock x:Name="TxtStatus" Text="系统准备就绪，请选择 Mods 目录进行扫描。" Foreground="#5E6278"/>
            </Border>
        </Grid>
    </Grid>
</Window>